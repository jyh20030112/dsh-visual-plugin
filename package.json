{
  "name": "dsh-visual-plugin",
  "version": "0.2.2",
  "description": "Vision bridge plugin for DeepSeek Harness: when the main model has no vision, forward user images to a configurable OpenAI-compatible vision model and show results in a Web UI right panel. Host tool + browser half, distributed as a dsh bundle.",
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "build": "node node_modules/tsdown/dist/run.mjs",
    "pack": "npm pack"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "connection",
        "locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-invariants": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "file:../deepseek-harness/vendor/schemastery",
    "@deepseek-ai/dsh-tools": "file:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-settings": "file:../deepseek-harness/packages/settings/settings",
    "@deepseek-ai/dsh-credentials": "file:../deepseek-harness/packages/credentials/credentials",
    "@deepseek-ai/dsh-attachment": "file:../deepseek-harness/packages/attachment/attachment",
    "@deepseek-ai/dsh-host-webserver": "file:../deepseek-harness/packages/host/webserver",
    "@deepseek-ai/dsh-llm": "file:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-system-prompt": "file:../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-invariants": "file:../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-agent": "file:../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-session": "file:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-client-runtime": "file:../deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-slots": "file:../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-tool": "file:../deepseek-harness/packages/client/ui-tool",
    "@deepseek-ai/dsh-client-ui-conversation": "file:../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-host-apiproxy": "file:../deepseek-harness/packages/host/apiproxy",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.2",
    "lightningcss": "^1.32.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1"
  },
  "license": "MIT"
}
